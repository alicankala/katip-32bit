// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",

  "appId": "com.katip.otoservis",
  "asar": true,
  "productName": "Kâtip",

  "directories": {
    "output": "release/${version}"
  },

  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],

  "asarUnpack": [
    "node_modules/better-sqlite3/**/*"
  ],

  "publish": {
    "provider": "github",
    "owner": "alicankala",
    "repo": "katip-32bit"
  },

"win": {
  "icon": "public/icon.ico",
  "target": [
    {
      "target": "nsis",
      "arch": [
        "ia32"
      ]
    }
  ],
  // Dosya adi bilerek ASCII: "Kâtip" icindeki 'â' yuzunden electron-builder
  // latest.yml'ye guvenli (ASCII) bir ad yaziyor, uretilen dosya ise ${productName}
  // ile adlandiriliyordu. Ikisi tutmayinca guncelleyici dosyayi bulamayip
  // sessizce basarisiz oluyordu. productName degismiyor, yalnizca dosya adi.
  // "-x86" eki 64-bit repodaki (katip) kurulum dosyasiyla karismasin diye eklendi.
  "artifactName": "Katip-Windows-x86-${version}-Setup.${ext}"
},
  "nsis": {
    // Assisted NSIS modu hem HKCU hem HKLM kurulumlarını algılar. Güncellemede
    // yalnız kurulum ilerlemesi gösterilir; seçim/Next/Finish beklenmez. Manuel ilk
    // kurulumda kapsam seçimi korunur. Böylece sürümler farklı klasörlerde çoğalmaz.
    "oneClick": false,
    "include": "installer/installer.nsh",
    "perMachine": false,
    // Eski makine-geneli ve yeni kullanıcı kurulumu birlikte bulunursa HKLM seçilir;
    // electron-builder aynı geçişte HKCU kopyasını da kaldırıp tek kuruluma düşürür.
    "selectPerMachineByDefault": true,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kâtip",
    "installerIcon": "public/icon.ico",
    "uninstallerIcon": "public/icon.ico"
  }
}
